{
  "cameraState": {
    "perspective": true,
    "distance": 15,
    "phi": 60,
    "thetaOffset": 45,
    "targetOffset": [0, 0, 0],
    "target": [0, 0, 0],
    "targetOrientation": [0, 0, 0, 1],
    "fovy": 45,
    "near": 0.5,
    "far": 5000
  },
  "followMode": "follow-pose",
  "followTf": "odom",
  "scene": {
    "transforms": {
      "showLabel": true,
      "labelSize": 0.2,
      "axisScale": 0.5
    },
    "syncCamera": false,
    "backgroundColor": "#0a0a1a"
  },
  "transforms": {
    "frame:odom": {"visible": true},
    "frame:base_link": {"visible": true},
    "frame:base_scan": {"visible": false}
  },
  "topics": {
    "/map": {
      "visible": true,
      "frameLocked": false,
      "minColor": "#1a1a2e",
      "maxColor": "#ff3355",
      "unknownColor": "#101020",
      "invalidColor": "#0000ff",
      "colorMode": "map",
      "alpha": 0.85
    },
    "/scan": {
      "visible": true,
      "pointSize": 4,
      "pointShape": "circle",
      "decayTime": 0,
      "colorMode": "flat",
      "flatColor": "#ff6600",
      "alpha": 0.7
    },
    "/odom": {
      "visible": true,
      "type": "axis",
      "axisScale": 0.6,
      "covariance": false
    },
    "/global_plan": {
      "visible": true,
      "lineWidth": 0.05,
      "type": "line",
      "gradient": ["#00aaff", "#00aaff"]
    },
    "/goal_pose": {
      "visible": true,
      "type": "axis",
      "axisScale": 0.5
    }
  },
  "layers": {
    "grid_layer": {
      "layerId": "foxglove.Grid",
      "label": "Grid",
      "visible": true,
      "color": "#222244",
      "size": 10,
      "divisions": 40,
      "lineWidth": 1,
      "frameId": "odom",
      "instanceId": "grid_layer"
    }
  },
  "publish": {
    "type": "pose",
    "poseTopic": "/goal_pose",
    "pointTopic": "/clicked_point",
    "poseEstimateTopic": "/initialpose",
    "poseEstimateXDeviation": 0.5,
    "poseEstimateYDeviation": 0.5,
    "poseEstimateThetaDeviation": 0.26
  }
}
